# Dockerfile.gpu - App image (tiny, fast to build/push)
# Inherits from base image which has PyTorch, Docling, and models
# Build: docker build -f Dockerfile.gpu -t ghcr.io/nshkrdotcom/lumainus-docling-gpu:latest .

ARG BASE_IMAGE=ghcr.io/nshkrdotcom/lumainus-docling-base:latest
FROM ${BASE_IMAGE}

# Copy only the service application code
COPY docling_service/app /app/service/app
COPY docling_service/run.sh /app/service/run.sh

# Set environment for GPU inference
ENV CUDA_VISIBLE_DEVICES=0
ENV OMP_NUM_THREADS=4
ENV HOST=0.0.0.0
ENV PORT=8042

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8042/health || exit 1

EXPOSE 8042

WORKDIR /app/service

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8042", "--no-access-log"]
