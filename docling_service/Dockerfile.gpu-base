# GPU-enabled runtime shared by the Docker CPU and GPU services.
FROM pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DOCLING_ARTIFACTS_PATH=/app/models/docling

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 curl procps \
    && rm -rf /var/lib/apt/lists/*

COPY docling_service/requirements.txt /app/requirements.txt
RUN python -m pip install -r /app/requirements.txt && python -m pip check

RUN docling-tools models download --output-dir "$DOCLING_ARTIFACTS_PATH"
