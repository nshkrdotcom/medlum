# Dockerfile.gpu - App image (tiny, fast to build/push)
# =====================================================
# Inherits from base image which has PyTorch, Docling, and models.
#
# Port is configurable via build arg and runtime env:
#   docker build --build-arg DOCLING_PORT=8043 ...
#   docker run -e PORT=8043 -p 8043:8043 ...
#
# Default ports (from docling-ports.env):
#   8042 - docker_cpu
#   8043 - docker_gpu

ARG BASE_IMAGE=ghcr.io/nshkrdotcom/medlum-docling-base:latest
FROM ${BASE_IMAGE}

# Port configuration (can be overridden at build time or runtime)
ARG DOCLING_PORT=8042
ENV PORT=${DOCLING_PORT}
ENV HOST=0.0.0.0

# Copy only the service application code
COPY docling_service/app /app/service/app
COPY docling_service/run.sh /app/service/run.sh

# Set environment for GPU inference
ENV CUDA_VISIBLE_DEVICES=0
ENV OMP_NUM_THREADS=4

# Health check using the PORT env var
# Note: Docker healthcheck doesn't expand env vars in CMD form, so use shell form
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Expose is just documentation; actual port binding happens at runtime
EXPOSE ${DOCLING_PORT}

WORKDIR /app/service

# Use shell form to allow env var expansion
CMD python -m uvicorn app.main:app --host ${HOST} --port ${PORT} --no-access-log
