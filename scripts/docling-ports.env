#!/usr/bin/env bash
# Docling Backend Port Assignments
# =================================
# Single source of truth for all Docling backend ports.
# Source this file in scripts: source "$(dirname "$0")/docling-ports.env"
#
# Port Layout (8040-8044):
#   8040 - Native CPU   (host Python/uvicorn, CPU only)
#   8041 - Native GPU   (host Python/uvicorn, CUDA)
#   8042 - Docker CPU   (container, CPU mode)
#   8043 - Docker GPU   (container, --gpus all)
#   8044 - Vast.ai      (cloud GPU, $$$)

# -----------------------------------------------------------------------------
# Port Assignments
# -----------------------------------------------------------------------------
export DOCLING_PORT_NATIVE_CPU=8040
export DOCLING_PORT_NATIVE_GPU=8041
export DOCLING_PORT_DOCKER_CPU=8042
export DOCLING_PORT_DOCKER_GPU=8043
export DOCLING_PORT_VAST_AI=8044

# -----------------------------------------------------------------------------
# Default URLs (loopback for local backends)
# -----------------------------------------------------------------------------
export DOCLING_URL_NATIVE_CPU="http://127.0.0.1:${DOCLING_PORT_NATIVE_CPU}"
export DOCLING_URL_NATIVE_GPU="http://127.0.0.1:${DOCLING_PORT_NATIVE_GPU}"
export DOCLING_URL_DOCKER_CPU="http://127.0.0.1:${DOCLING_PORT_DOCKER_CPU}"
export DOCLING_URL_DOCKER_GPU="http://127.0.0.1:${DOCLING_PORT_DOCKER_GPU}"
# DOCLING_URL_VAST_AI is set dynamically when a Vast.ai instance is provisioned

# -----------------------------------------------------------------------------
# Backend Types (for script logic)
# -----------------------------------------------------------------------------
# Local backends (user chooses "Local" in UI):
#   native_cpu, native_gpu, docker_cpu, docker_gpu
#
# Cloud backends (user chooses "Cloud $$$" in UI):
#   vast_ai

# -----------------------------------------------------------------------------
# Helper: Get port for backend type
# Usage: port=$(docling_port_for native_cpu)
# -----------------------------------------------------------------------------
docling_port_for() {
    local backend="$1"
    case "$backend" in
        native_cpu)  echo "$DOCLING_PORT_NATIVE_CPU" ;;
        native_gpu)  echo "$DOCLING_PORT_NATIVE_GPU" ;;
        docker_cpu)  echo "$DOCLING_PORT_DOCKER_CPU" ;;
        docker_gpu)  echo "$DOCLING_PORT_DOCKER_GPU" ;;
        vast_ai)     echo "$DOCLING_PORT_VAST_AI" ;;
        *)           echo "$DOCLING_PORT_DOCKER_CPU" ;;  # default
    esac
}

# -----------------------------------------------------------------------------
# Helper: Get URL for backend type
# Usage: url=$(docling_url_for docker_gpu)
# -----------------------------------------------------------------------------
docling_url_for() {
    local backend="$1"
    case "$backend" in
        native_cpu)  echo "$DOCLING_URL_NATIVE_CPU" ;;
        native_gpu)  echo "$DOCLING_URL_NATIVE_GPU" ;;
        docker_cpu)  echo "$DOCLING_URL_DOCKER_CPU" ;;
        docker_gpu)  echo "$DOCLING_URL_DOCKER_GPU" ;;
        vast_ai)     echo "${DOCLING_URL_VAST_AI:-}" ;;
        *)           echo "$DOCLING_URL_DOCKER_CPU" ;;  # default
    esac
}

# -----------------------------------------------------------------------------
# Helper: Check if backend uses GPU
# Usage: if docling_is_gpu docker_gpu; then ...
# -----------------------------------------------------------------------------
docling_is_gpu() {
    local backend="$1"
    case "$backend" in
        native_gpu|docker_gpu|vast_ai) return 0 ;;
        *) return 1 ;;
    esac
}

# -----------------------------------------------------------------------------
# Helper: Check if backend is cloud (costs $$$)
# Usage: if docling_is_cloud vast_ai; then ...
# -----------------------------------------------------------------------------
docling_is_cloud() {
    local backend="$1"
    case "$backend" in
        vast_ai) return 0 ;;
        *) return 1 ;;
    esac
}

# -----------------------------------------------------------------------------
# Helper: List all local backend types
# -----------------------------------------------------------------------------
docling_local_backends() {
    echo "native_cpu native_gpu docker_cpu docker_gpu"
}

# -----------------------------------------------------------------------------
# Helper: Print port table
# -----------------------------------------------------------------------------
docling_print_ports() {
    echo "Docling Backend Ports:"
    echo "  native_cpu  : $DOCLING_PORT_NATIVE_CPU  ($DOCLING_URL_NATIVE_CPU)"
    echo "  native_gpu  : $DOCLING_PORT_NATIVE_GPU  ($DOCLING_URL_NATIVE_GPU)"
    echo "  docker_cpu  : $DOCLING_PORT_DOCKER_CPU  ($DOCLING_URL_DOCKER_CPU)"
    echo "  docker_gpu  : $DOCLING_PORT_DOCKER_GPU  ($DOCLING_URL_DOCKER_GPU)"
    echo "  vast_ai     : $DOCLING_PORT_VAST_AI  (${DOCLING_URL_VAST_AI:-<not provisioned>})"
}
