<style>
  /* Clinical Command Center - Homepage */

  /* Hide root menu on homepage */
  body:has(.clinical-command-center) > ul.menu {
    display: none !important;
  }

  body:has(.clinical-command-center) {
    margin: 0;
    padding: 0;
    overflow: hidden;
    height: 100vh;
  }

  .clinical-command-center {
    height: 100vh;
    background: #0a0f1e;
    position: relative;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  /* Animated background - Neural network activity */
  .clinical-command-center::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/images/patterns/neural-network-pattern.svg');
    background-size: 600px 600px;
    opacity: 0.15;
    animation: neuralDrift 40s linear infinite;
  }

  .clinical-command-center::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 30% 40%, rgba(59, 130, 246, 0.08), transparent 60%);
    pointer-events: none;
  }

  @keyframes neuralDrift {
    from { background-position: 0 0; }
    to { background-position: 600px 600px; }
  }

  /* System Status Bar (Top) */
  .status-bar {
    position: relative;
    z-index: 20;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(59, 130, 246, 0.2);
    padding: 0.75rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .status-bar-left {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .system-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .system-logo img {
    width: 32px;
    height: 32px;
    filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.5));
  }

  .system-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: #60a5fa;
    letter-spacing: -0.02em;
  }

  .vital-indicators {
    display: flex;
    gap: 1.5rem;
  }

  .vital {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
  }

  .vital-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    animation: pulse 2s ease-in-out infinite;
  }

  .vital.amber .vital-pulse { background: #f59e0b; }
  .vital.cyan .vital-pulse { background: #06b6d4; }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.2); }
  }

  .vital-label {
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .vital-value {
    color: #f8fafc;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .status-bar-right {
    display: flex;
    gap: 1rem;
  }

  .status-time {
    font-size: 0.75rem;
    color: #64748b;
    font-variant-numeric: tabular-nums;
  }

  /* Main Viewport - Multi-panel layout */
  .viewport {
    position: relative;
    z-index: 10;
    height: calc(100vh - 60px);
    display: grid;
    grid-template-columns: 350px 1fr 350px;
    gap: 1px;
    background: rgba(59, 130, 246, 0.1);
    padding: 1px;
  }

  /* Individual Panels */
  .panel {
    background: rgba(10, 15, 30, 0.8);
    backdrop-filter: blur(20px);
    position: relative;
    overflow: hidden;
  }

  .panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(59, 130, 246, 0.05) 0%, transparent 100%);
    pointer-events: none;
  }

  /* Scan line effect */
  .panel::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #3b82f6, transparent);
    opacity: 0.3;
    animation: scanLine 8s linear infinite;
  }

  @keyframes scanLine {
    from { transform: translateY(0); }
    to { transform: translateY(calc(100vh - 60px)); }
  }

  .panel-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(59, 130, 246, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .panel-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .panel-icon {
    width: 16px;
    height: 16px;
    opacity: 0.7;
  }

  .panel-body {
    padding: 1.5rem;
    height: calc(100% - 60px);
    overflow-y: auto;
  }

  /* Left Panel: System Metrics */
  .metric-group {
    margin-bottom: 2rem;
  }

  .metric-group-title {
    font-size: 0.75rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .metric {
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 0.5rem;
    padding: 1rem;
    margin-bottom: 0.75rem;
    transition: all 0.3s ease;
  }

  .metric:hover {
    border-color: rgba(59, 130, 246, 0.4);
    transform: translateX(4px);
  }

  .metric-label {
    font-size: 0.75rem;
    color: #94a3b8;
    margin-bottom: 0.5rem;
  }

  .metric-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: #f8fafc;
    font-variant-numeric: tabular-nums;
  }

  .metric-trend {
    font-size: 0.75rem;
    color: #10b981;
    margin-top: 0.25rem;
  }

  .metric-bar {
    height: 4px;
    background: rgba(59, 130, 246, 0.2);
    border-radius: 2px;
    margin-top: 0.75rem;
    overflow: hidden;
  }

  .metric-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #3b82f6, #60a5fa);
    border-radius: 2px;
    transition: width 1s ease;
  }

  /* Center Panel: Neural Visualization */
  .neural-viz {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem;
  }

  .neural-core {
    position: relative;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .neural-core img {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 40px rgba(59, 130, 246, 0.6));
    animation: floatRotate 20s ease-in-out infinite;
  }

  @keyframes floatRotate {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(5deg); }
  }

  .tagline-overlay {
    position: absolute;
    bottom: 10%;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    max-width: 600px;
  }

  .tagline-overlay h1 {
    font-size: 2rem;
    font-weight: 700;
    background: linear-gradient(135deg, #60a5fa, #3b82f6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .tagline-overlay p {
    font-size: 0.875rem;
    color: #94a3b8;
    line-height: 1.6;
  }

  .tagline-overlay em {
    color: #60a5fa;
    font-style: normal;
    font-weight: 600;
  }

  .cta-button {
    margin-top: 2rem;
    padding: 1rem 2.5rem;
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    border: none;
    border-radius: 0.75rem;
    color: white;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.3);
    text-decoration: none;
    display: inline-block;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(59, 130, 246, 0.5);
  }

  /* Right Panel: Evidence Tracker */
  .evidence-stream {
    font-size: 0.8rem;
  }

  .evidence-item {
    background: rgba(15, 23, 42, 0.5);
    border-left: 3px solid #3b82f6;
    padding: 1rem;
    margin-bottom: 1rem;
    border-radius: 0.25rem;
    animation: slideInRight 0.5s ease-out;
    animation-fill-mode: backwards;
  }

  .evidence-item:nth-child(1) { animation-delay: 0.1s; }
  .evidence-item:nth-child(2) { animation-delay: 0.2s; }
  .evidence-item:nth-child(3) { animation-delay: 0.3s; }
  .evidence-item:nth-child(4) { animation-delay: 0.4s; }
  .evidence-item:nth-child(5) { animation-delay: 0.5s; }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .evidence-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .evidence-type {
    font-size: 0.7rem;
    color: #3b82f6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .evidence-confidence {
    font-size: 0.7rem;
    color: #10b981;
    font-weight: 600;
  }

  .evidence-content {
    color: #cbd5e1;
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }

  .evidence-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.7rem;
    color: #64748b;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .capability {
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 0.5rem;
    padding: 1rem;
    text-align: center;
    transition: all 0.3s ease;
  }

  .capability:hover {
    border-color: rgba(59, 130, 246, 0.5);
    transform: scale(1.05);
  }

  .capability img {
    width: 32px;
    height: 32px;
    margin: 0 auto 0.5rem;
    opacity: 0.8;
  }

  .capability-name {
    font-size: 0.75rem;
    color: #cbd5e1;
    font-weight: 600;
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .viewport {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr auto;
    }

    .panel-left,
    .panel-right {
      max-height: 300px;
    }

    .status-bar {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }

    .vital-indicators {
      flex-wrap: wrap;
    }
  }

  @media (max-width: 768px) {
    .viewport {
      gap: 0;
    }

    .panel-left,
    .panel-right {
      display: none;
    }

    .tagline-overlay h1 {
      font-size: 1.5rem;
    }

    .cta-button {
      padding: 0.875rem 2rem;
      font-size: 0.875rem;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .clinical-command-center::before,
    .panel::after,
    .neural-core img,
    .evidence-item {
      animation: none !important;
    }
  }
</style>

<div class="clinical-command-center">
  <!-- System Status Bar -->
  <div class="status-bar">
    <div class="status-bar-left">
      <div class="system-logo">
        <img src={~p"/favicon.svg"} alt="Lumainus" />
        <span class="system-name">LUMAINUS</span>
      </div>

      <div class="vital-indicators">
        <div class="vital">
          <div class="vital-pulse"></div>
          <span class="vital-label">System</span>
          <span class="vital-value">Online</span>
        </div>
        <div class="vital amber">
          <div class="vital-pulse"></div>
          <span class="vital-label">Confidence</span>
          <span class="vital-value">94.3%</span>
        </div>
        <div class="vital cyan">
          <div class="vital-pulse"></div>
          <span class="vital-label">Uptime</span>
          <span class="vital-value">99.97%</span>
        </div>
      </div>
    </div>

    <div class="status-bar-right">
      <div class="status-time" id="system-time">
        <%= Calendar.strftime(DateTime.utc_now(), "%Y-%m-%d %H:%M:%S UTC") %>
      </div>
    </div>
  </div>

  <!-- Multi-Panel Viewport -->
  <div class="viewport">
    <!-- Left Panel: System Metrics -->
    <div class="panel panel-left">
      <div class="panel-header">
        <div class="panel-title">
          <img src={~p"/images/icon-audit.svg"} alt="" class="panel-icon" />
          Live Metrics
        </div>
      </div>
      <div class="panel-body">
        <div class="metric-group">
          <div class="metric-group-title">Performance</div>
          <div class="metric">
            <div class="metric-label">Avg Response Time</div>
            <div class="metric-value">1.8<span style="font-size: 0.875rem; color: #94a3b8;">s</span>
            </div>
            <div class="metric-trend">↓ 12% from baseline</div>
            <div class="metric-bar">
              <div class="metric-bar-fill" style="width: 92%"></div>
            </div>
          </div>

          <div class="metric">
            <div class="metric-label">Multi-Agent Agreement</div>
            <div class="metric-value">94<span style="font-size: 0.875rem; color: #94a3b8;">%</span>
            </div>
            <div class="metric-trend">↑ 3% vs baseline</div>
            <div class="metric-bar">
              <div class="metric-bar-fill" style="width: 94%"></div>
            </div>
          </div>
        </div>

        <div class="metric-group">
          <div class="metric-group-title">Evidence Quality</div>
          <div class="metric">
            <div class="metric-label">Citation Coverage</div>
            <div class="metric-value">100<span style="font-size: 0.875rem; color: #94a3b8;">%</span>
            </div>
            <div class="metric-trend">All claims cited</div>
            <div class="metric-bar">
              <div class="metric-bar-fill" style="width: 100%"></div>
            </div>
          </div>

          <div class="metric">
            <div class="metric-label">Validation Rate</div>
            <div class="metric-value">91.2<span style="font-size: 0.875rem; color: #94a3b8;">%</span>
            </div>
            <div class="metric-bar">
              <div class="metric-bar-fill" style="width: 91%"></div>
            </div>
          </div>
        </div>

        <div class="metric-group">
          <div class="metric-group-title">System Health</div>
          <div class="metric">
            <div class="metric-label">Drift Detection</div>
            <div class="metric-value" style="font-size: 1.25rem; color: #10b981;">NONE</div>
            <div class="metric-trend">KS test p=0.72</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Center Panel: Neural Visualization -->
    <div class="panel panel-center">
      <div class="neural-viz">
        <div class="neural-core">
          <img src={~p"/images/lumainus-logo-enhanced.svg"} alt="Neural Network" />
        </div>

        <div class="tagline-overlay">
          <h1>Traceable AI Intelligence</h1>
          <p>
            Every token has a <em>traceable decision path</em>.<br />
            Every claim has <em>attributable evidence</em>.<br />
            Every response has <em>measurable confidence</em>.
          </p>

          <a href={~p"/users/log-in"} class="cta-button">
            Access Command Center →
          </a>
        </div>
      </div>
    </div>

    <!-- Right Panel: Evidence Tracker -->
    <div class="panel panel-right">
      <div class="panel-header">
        <div class="panel-title">
          <img src={~p"/images/icon-transparency.svg"} alt="" class="panel-icon" />
          Evidence Stream
        </div>
      </div>
      <div class="panel-body">
        <div class="evidence-stream">
          <div class="evidence-item">
            <div class="evidence-header">
              <span class="evidence-type">Decision Path</span>
              <span class="evidence-confidence">95.2%</span>
            </div>
            <div class="evidence-content">
              Proposal B selected via ensemble voting across 7 parallel critics
            </div>
            <div class="evidence-meta">
              <span>Logic: 0.95</span>
              <span>Grounding: 0.92</span>
              <span>Safety: 1.0</span>
            </div>
          </div>

          <div class="evidence-item">
            <div class="evidence-header">
              <span class="evidence-type">Citation</span>
              <span class="evidence-confidence">100%</span>
            </div>
            <div class="evidence-content">
              3 sources validated: Cochrane Review 2013, Meta-analysis N=11,306
            </div>
            <div class="evidence-meta">
              <span>Coverage: 3/3</span>
              <span>Verified</span>
            </div>
          </div>

          <div class="evidence-item">
            <div class="evidence-header">
              <span class="evidence-type">Validation</span>
              <span class="evidence-confidence">91.8%</span>
            </div>
            <div class="evidence-content">
              Statistical tests passed: KS p=0.72, Cohen's d=0.12 (negligible drift)
            </div>
            <div class="evidence-meta">
              <span>Baseline OK</span>
              <span>No alerts</span>
            </div>
          </div>

          <div class="evidence-item">
            <div class="evidence-header">
              <span class="evidence-type">Audit Trail</span>
              <span class="evidence-confidence">—</span>
            </div>
            <div class="evidence-content">
              Full trace logged: 847 tokens, 12 decision nodes, 2.3s processing
            </div>
            <div class="evidence-meta">
              <span>Compliant</span>
              <span>Exportable</span>
            </div>
          </div>

          <div class="capability-grid">
            <div class="capability">
              <img src={~p"/images/icon-transparency.svg"} alt="" />
              <div class="capability-name">Full Transparency</div>
            </div>

            <div class="capability">
              <img src={~p"/images/icon-audit.svg"} alt="" />
              <div class="capability-name">6-Year Audit</div>
            </div>

            <div class="capability">
              <img src={~p"/images/icon-network.svg"} alt="" />
              <div class="capability-name">Multi-Agent</div>
            </div>

            <div class="capability">
              <img src={~p"/images/patterns/data-viz-pattern-static.svg"} alt="" />
              <div class="capability-name">Real-Time Stats</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Update system time every second
  setInterval(() => {
    const now = new Date();
    const timeStr = now.toISOString().slice(0, 19).replace('T', ' ') + ' UTC';
    const timeEl = document.getElementById('system-time');
    if (timeEl) timeEl.textContent = timeStr;
  }, 1000);
</script>
