<style>
  /* Serene Medical Waiting Room - Calm, Simple, Breathable */

  /* Reset body styles for immersive layout */
  body:has(.lumainus-sanctuary) {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }

  .lumainus-sanctuary {
    min-height: 100vh;
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 50%, #e2e8f0 100%);
    position: relative;
    overflow: hidden;
  }

  /* Soft organic background shapes - like abstract art in a waiting room */
  .lumainus-sanctuary::before {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 60%;
    height: 60%;
    background: radial-gradient(circle, rgba(96, 165, 250, 0.08) 0%, transparent 70%);
    border-radius: 50%;
    animation: breathe 12s ease-in-out infinite;
  }

  .lumainus-sanctuary::after {
    content: '';
    position: absolute;
    bottom: -15%;
    left: -10%;
    width: 50%;
    height: 50%;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.06) 0%, transparent 70%);
    border-radius: 50%;
    animation: breathe 15s ease-in-out infinite 2s;
  }

  @keyframes breathe {
    0%, 100% { transform: scale(1) translateY(0); opacity: 1; }
    50% { transform: scale(1.1) translateY(-20px); opacity: 0.8; }
  }

  /* Subtle pattern overlay - like gentle wallpaper texture */
  .pattern-overlay {
    position: absolute;
    inset: 0;
    background-image: url('/images/patterns/medical-tech-pattern-static.svg');
    background-size: 800px 800px;
    opacity: 0.02;
    pointer-events: none;
  }

  /* Main content - centered vertical flow */
  .sanctuary-content {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    text-align: center;
  }

  /* Floating logo - the centerpiece */
  .logo-centerpiece {
    margin-bottom: 4rem;
    animation: float 8s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
  }

  .logo-centerpiece img {
    width: 180px;
    height: 180px;
    filter: drop-shadow(0 20px 40px rgba(59, 130, 246, 0.15));
    transition: transform 0.6s ease;
  }

  .logo-centerpiece:hover img {
    transform: scale(1.05);
  }

  /* Brand name - elegant typography */
  .brand-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 300;
    letter-spacing: 0.1em;
    color: #1e293b;
    margin-bottom: 2rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .brand-title strong {
    font-weight: 600;
  }

  /* Tagline - soft, reassuring */
  .tagline {
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.8;
    color: #64748b;
    max-width: 600px;
    margin: 0 auto 4rem;
    font-weight: 400;
  }

  .tagline-emphasis {
    color: #3b82f6;
    font-weight: 500;
  }

  /* Simple, inviting CTA */
  .entry-portal {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 3rem;
    background: white;
    border: 2px solid rgba(59, 130, 246, 0.2);
    border-radius: 100px;
    color: #1e293b;
    font-size: 1.125rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.08);
  }

  .entry-portal:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(59, 130, 246, 0.15);
    border-color: rgba(59, 130, 246, 0.4);
    background: #fafbfc;
  }

  .entry-portal::after {
    content: '→';
    font-size: 1.25rem;
    transition: transform 0.3s ease;
  }

  .entry-portal:hover::after {
    transform: translateX(4px);
  }

  /* Subtle footer info */
  .sanctuary-footer {
    position: absolute;
    bottom: 2rem;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 0.875rem;
    color: #94a3b8;
    z-index: 2;
  }

  /* Trust indicators - subtle, minimal */
  .trust-marks {
    display: flex;
    justify-content: center;
    gap: 3rem;
    margin-top: 6rem;
    flex-wrap: wrap;
  }

  .trust-mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .trust-mark:hover {
    opacity: 1;
  }

  .trust-mark img {
    width: 48px;
    height: 48px;
    opacity: 0.5;
  }

  .trust-mark-label {
    font-size: 0.875rem;
    color: #64748b;
    font-weight: 500;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .sanctuary-content {
      padding: 3rem 1.5rem;
    }

    .logo-centerpiece img {
      width: 140px;
      height: 140px;
    }

    .brand-title {
      margin-bottom: 1.5rem;
    }

    .tagline {
      margin-bottom: 3rem;
    }

    .entry-portal {
      padding: 1rem 2rem;
      font-size: 1rem;
    }

    .trust-marks {
      gap: 2rem;
      margin-top: 4rem;
    }
  }

  /* Accessibility - reduce motion */
  @media (prefers-reduced-motion: reduce) {
    .lumainus-sanctuary::before,
    .lumainus-sanctuary::after,
    .logo-centerpiece {
      animation: none !important;
    }

    .entry-portal:hover {
      transform: none;
    }
  }

  /* Light particles floating - very subtle */
  @keyframes particleFloat {
    0% { transform: translateY(100vh) translateX(0) scale(0); opacity: 0; }
    10% { opacity: 0.3; }
    90% { opacity: 0.1; }
    100% { transform: translateY(-100vh) translateX(50px) scale(1); opacity: 0; }
  }

  .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: rgba(59, 130, 246, 0.3);
    border-radius: 50%;
    pointer-events: none;
  }

  .particle:nth-child(1) { left: 10%; animation: particleFloat 25s ease-in infinite; }
  .particle:nth-child(2) { left: 30%; animation: particleFloat 30s ease-in infinite 5s; }
  .particle:nth-child(3) { left: 50%; animation: particleFloat 28s ease-in infinite 10s; }
  .particle:nth-child(4) { left: 70%; animation: particleFloat 32s ease-in infinite 3s; }
  .particle:nth-child(5) { left: 90%; animation: particleFloat 27s ease-in infinite 8s; }
</style>

<div class="lumainus-sanctuary">
  <!-- Subtle pattern texture -->
  <div class="pattern-overlay"></div>
  
<!-- Floating particles - very subtle -->
  <div class="particle"></div>
  <div class="particle"></div>
  <div class="particle"></div>
  <div class="particle"></div>
  <div class="particle"></div>
  
<!-- Main content -->
  <div class="sanctuary-content">
    <span class="sr-only">Welcome to MedLum AI</span>
    <!-- Central logo - the peaceful focal point -->
    <div class="logo-centerpiece">
      <img src={~p"/images/medlumai-logo.svg"} alt="MedLum AI" />
    </div>
    
<!-- Brand name - minimal, elegant -->
    <h1 class="brand-title">
      <strong>MEDLUM AI</strong>
    </h1>
    
<!-- Simple, reassuring message -->
    <p class="tagline">
      <span class="tagline-emphasis">Traceable AI intelligence</span>
      for healthcare.<br />
      Every decision transparent. Every claim verified. Every response measured.
    </p>
    
<!-- Single, clear action -->
    <a href={~p"/users/log-in"} class="entry-portal">
      Enter
    </a>
    
<!-- Minimal trust indicators -->
    <div class="trust-marks">
      <div class="trust-mark">
        <img src={~p"/images/icon-transparency.svg"} alt="" />
        <span class="trust-mark-label">Transparent</span>
      </div>

      <div class="trust-mark">
        <img src={~p"/images/icon-audit.svg"} alt="" />
        <span class="trust-mark-label">Auditable</span>
      </div>

      <div class="trust-mark">
        <img src={~p"/images/icon-network.svg"} alt="" />
        <span class="trust-mark-label">Verified</span>
      </div>
    </div>
  </div>
  
<!-- Subtle footer -->
  <div class="sanctuary-footer">
    Invitation-only access · Contact your administrator
  </div>
</div>
